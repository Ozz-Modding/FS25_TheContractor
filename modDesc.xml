<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="115">
    <author>Ozz</author>
    <version>1.0.0.0</version>
    <iconFilename>icon_TheContractor.dds</iconFilename>
    <title>
        <en>The Contractor</en>
    </title>
    <description>
        <en><![CDATA[The Contractor

        TODO: Ensure credit given to Arrow-kb FS25_PlaceableNPCSystem
]]>
        </en>
    </description>

    <extraSourceFiles>
        <sourceFile filename="src/main.lua"/>
    </extraSourceFiles>

    <!-- 062: parking slots. 065: standing spots. 100: repair zones. 146: yard centre markers. -->
    <placeableSpecializations>
        <specialization name="tcParkingSlot" className="PlaceableTCParkingSlot" filename="src/placeables/PlaceableTCParkingSlot.lua" />
        <specialization name="tcStandingSpot" className="PlaceableTCStandingSpot" filename="src/placeables/PlaceableTCStandingSpot.lua" />
        <specialization name="tcYardCentre" className="PlaceableTCYardCentre" filename="src/placeables/PlaceableTCYardCentre.lua" />
        <specialization name="tcDisposalSkip" className="PlaceableTCDisposalSkip" filename="src/placeables/PlaceableTCDisposalSkip.lua" />
        <specialization name="tcLogoSign" className="PlaceableTCLogoSign" filename="src/placeables/PlaceableTCLogoSign.lua" />
        <specialization name="tcRepairZone" className="PlaceableTCRepairZone" filename="src/placeables/PlaceableTCRepairZone.lua" />
    </placeableSpecializations>
    <placeableTypes>
        <type name="tcParkingSlot" parent="placeable" className="Placeable" filename="$dataS/scripts/placeables/Placeable.lua">
            <specialization name="placement" />
            <specialization name="tcParkingSlot" />
        </type>
        <type name="tcStandingSpot" parent="placeable" className="Placeable" filename="$dataS/scripts/placeables/Placeable.lua">
            <specialization name="placement" />
            <specialization name="tcStandingSpot" />
        </type>
        <type name="tcYardCentre" parent="placeable" className="Placeable" filename="$dataS/scripts/placeables/Placeable.lua">
            <specialization name="placement" />
            <specialization name="tcYardCentre" />
        </type>
        <type name="tcDisposalSkip" parent="placeable" className="Placeable" filename="$dataS/scripts/placeables/Placeable.lua">
            <specialization name="placement" />
            <specialization name="tcDisposalSkip" />
        </type>
        <type name="tcLogoSign" parent="placeable" className="Placeable" filename="$dataS/scripts/placeables/Placeable.lua">
            <specialization name="placement" />
            <specialization name="tcLogoSign" />
        </type>
        <type name="tcRepairZone" parent="placeable" className="Placeable" filename="$dataS/scripts/placeables/Placeable.lua">
            <specialization name="placement" />
            <specialization name="tcRepairZone" />
        </type>
    </placeableTypes>
    <storeItems>
        <storeItem xmlFilename="xml/parkingSlot.xml" />
        <storeItem xmlFilename="xml/parkingSlotMedium.xml" />
        <storeItem xmlFilename="xml/parkingSlotLarge.xml" />
        <storeItem xmlFilename="xml/parkingSlotImplement.xml" />
        <storeItem xmlFilename="xml/parkingSlotImplementMedium.xml" />
        <storeItem xmlFilename="xml/parkingSlotImplementLarge.xml" />
        <storeItem xmlFilename="xml/parkingSlotHarvester.xml" />
        <storeItem xmlFilename="xml/standingSpot.xml" />
        <storeItem xmlFilename="xml/yardCentre.xml" />
        <storeItem xmlFilename="xml/disposalSkip.xml" />
        <storeItem xmlFilename="xml/logoSign.xml" />
        <storeItem xmlFilename="xml/wallSign1m.xml" />
        <storeItem xmlFilename="xml/wallSign3m.xml" />
        <storeItem xmlFilename="xml/wallSign6m.xml" />
        <storeItem xmlFilename="xml/wallSignLarge1m.xml" />
        <storeItem xmlFilename="xml/wallSignLarge3m.xml" />
        <storeItem xmlFilename="xml/wallSignLarge6m.xml" />
        <storeItem xmlFilename="xml/repairZone.xml" />
        <storeItem xmlFilename="xml/repairZoneMedium.xml" />
        <storeItem xmlFilename="xml/repairZoneLarge.xml" />
        <storeItem xmlFilename="xml/repairZoneHarvester.xml" />
    </storeItems>

    <constructionCategories>
        <tab categoryName="buildings" name="contractor" title="$l10n_tc_construction_tab" />
    </constructionCategories>

    <l10n filenamePrefix="languages/l10n" />

    <!-- 086: shows/hides parking slots outside the construction menu (TCParking). -->
    <actions>
        <action name="TC_TOGGLE_PARKING_SLOTS" category="SYSTEM" axisType="HALF" ignoreComboMask="false" />
    </actions>
    <inputBinding>
        <actionBinding action="TC_TOGGLE_PARKING_SLOTS">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_rctrl KEY_p" />
        </actionBinding>
    </inputBinding>
    <multiplayer supported="true"/>
</modDesc>
