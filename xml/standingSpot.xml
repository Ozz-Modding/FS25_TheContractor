<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    065 standing spot: where an idle worker is shown standing in the yard
    (src/placeables/PlaceableTCStandingSpot.lua, src/util/TCIdleStaff.lua).
    A marker only, like the parking slots: no leveling or foliage clearing,
    and its stripes are terrain decals shown only while the construction
    menu is open. The worker stands on standNode facing the arrow (+Z). The
    blocker stops players walking through them, and is only in physics
    while someone's standing there.
-->
<placeable type="FS25_TheContractor.tcStandingSpot">
    <storeData>
        <name>$l10n_tc_standingSpot_name</name>
        <functions>
            <function>$l10n_tc_standingSpot_function</function>
        </functions>
        <image>images/store/standingSpot.dds</image>
        <price>0</price>
        <dailyUpkeep>0</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>misc</category>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>

        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>contractor</tab>
        </brush>
    </storeData>

    <base>
        <filename>i3d/standingSpot.i3d</filename>
        <canBeRenamed>false</canBeRenamed>
        <boughtWithFarmland>false</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testAreaStart" endNode="testAreaEnd" />
        </testAreas>
        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <standingSpot startNode="areaStart" widthNode="areaWidth" heightNode="areaHeight" visualsNode="visuals"
        standNode="standNode" blockerNode="blocker" />

    <i3dMappings>
        <i3dMapping id="standingSpot" node="0>" />
        <i3dMapping id="areaStart" node="0>0" />
        <i3dMapping id="areaWidth" node="0>1" />
        <i3dMapping id="areaHeight" node="0>2" />
        <i3dMapping id="testAreaStart" node="0>3|0" />
        <i3dMapping id="testAreaEnd" node="0>3|0|0" />
        <i3dMapping id="pickCollision" node="0>4" />
        <i3dMapping id="visuals" node="0>5" />
        <i3dMapping id="standNode" node="0>6" />
        <i3dMapping id="blocker" node="0>7" />
    </i3dMappings>
</placeable>
