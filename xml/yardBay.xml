<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    183 yard machine bay, 8 m x 13.5 m: where a farmer's machine or trailer comes
    out in their yard, ahead of the yard's standing spots
    (src/placeables/PlaceableTCYardBay.lua, src/util/TCYardBays.lua). Only
    placeable whole on a yard no player owns, any number, by the host or an
    admin. A marker only: the harvester parking slot's i3d (062). Its stripes show with the parking
    slots. Machines face from the start edge towards the height node.
-->
<placeable type="FS25_TheContractor.tcYardBay">
    <storeData>
        <name>$l10n_tc_yardBay_name</name>
        <functions>
            <function>$l10n_tc_yardBay_function</function>
        </functions>
        <image>images/store/yardBay.dds</image>
        <price>0</price>
        <dailyUpkeep>0</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>misc</category>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>

        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>contractor</tab>
        </brush>
    </storeData>

    <base>
        <filename>i3d/parkingSlotHarvester.i3d</filename>
        <canBeRenamed>false</canBeRenamed>
        <boughtWithFarmland>false</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testAreaStart" endNode="testAreaEnd" />
        </testAreas>
        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <yardBay startNode="areaStart" widthNode="areaWidth" heightNode="areaHeight" visualsNode="visuals" />

    <i3dMappings>
        <i3dMapping id="yardBay" node="0>" />
        <i3dMapping id="areaStart" node="0>0" />
        <i3dMapping id="areaWidth" node="0>1" />
        <i3dMapping id="areaHeight" node="0>2" />
        <i3dMapping id="testAreaStart" node="0>3|0" />
        <i3dMapping id="testAreaEnd" node="0>3|0|0" />
        <i3dMapping id="pickCollision" node="0>4" />
        <i3dMapping id="visuals" node="0>5" />
    </i3dMappings>
</placeable>
