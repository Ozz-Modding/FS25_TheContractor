<?xml version="1.0" encoding="iso-8859-1"?>

<!-- Staff tab worker portrait scene (042), rendered by a Render element
     (TCWorkerPortrait). Hand-written, modelled on RealisticLivestock's
     earTagScene.i3d: the character is loaded into "character" from Lua, and
     the camera framing is set from Lua too (TCWorkerPortrait.CAMERA_*), so
     tuning it doesn't need this file touched. The lights' objectMask
     0x4000000 matches RenderElement's default lightMask. Node order matters:
     TCWorkerPortrait and the Render element's cameraNode="0|1" index it. -->
<i3D name="workerPortrait.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.4"/>
  </Asset>

  <Files>
  </Files>

  <Materials>
  </Materials>

  <Shapes>
  </Shapes>

  <Scene>
    <TransformGroup name="portraitSceneRoot" nodeId="1">
      <TransformGroup name="character" nodeId="2"/>
      <Camera name="portraitCamera" translation="0 1.55 1.1" nodeId="3" fov="30" nearClip="0.05" farClip="100"/>
      <Light name="keyLight" rotation="-25 25 0" objectMask="0x4000000" nodeId="4" type="directional" color="1 1 1" emitDiffuse="true" emitSpecular="true" castShadowMap="false" range="10"/>
      <Light name="fillLight" rotation="-10 -50 0" objectMask="0x4000000" nodeId="5" type="directional" color="0.45 0.45 0.5" emitDiffuse="true" emitSpecular="false" castShadowMap="false" range="10"/>
      <Light name="rimLight" rotation="-20 180 0" objectMask="0x4000000" nodeId="6" type="directional" color="0.35 0.35 0.35" emitDiffuse="true" emitSpecular="false" castShadowMap="false" range="10"/>
    </TransformGroup>
  </Scene>

</i3D>
