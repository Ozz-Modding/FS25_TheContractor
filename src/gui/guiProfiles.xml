<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUIProfiles>
    <!-- Panel kit (043, modelled on FS25_AdvancedDamageSystem's menus): one
         palette for the whole Contractor page. Lists sit on the page as
         card rows; everything else (details, overview sections) sits in a
         dark panel with a green section title, a hairline divider, and
         muted-label / bright-value rows. Status is shown as coloured chips
         (tones in MenuContractor.CHIP_COLORS), not coloured text. -->
    <Presets>
        <Preset name="tc_panelSurface" value="0.018 0.018 0.018 0.94"/>
        <Preset name="tc_rowSurface" value="0.03 0.03 0.03 0.96"/>
        <Preset name="tc_rowFocused" value="0.06 0.066 0.048 1"/>
        <Preset name="tc_rowSelected" value="0.13 0.17 0.05 1"/>
        <Preset name="tc_divider" value="0.13 0.13 0.14 1"/>
        <Preset name="tc_headerDivider" value="0.3 0.3 0.3 1"/>
        <Preset name="tc_mutedText" value="0.45 0.45 0.45 1"/>
        <Preset name="tc_valueText" value="0.88 0.88 0.88 1"/>
    </Presets>

    <Profile name="tc_panel" extends="baseReference" with="anchorTopLeft">
        <color value="$preset_tc_panelSurface"/>
        <cornerSize value="0.3"/>
    </Profile>
    <!-- Green uppercase section title with a hairline under it. -->
    <Profile name="tc_sectionTitle" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="600px 24px"/>
        <textSize value="16px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="tc_divider" extends="baseReference" with="anchorTopLeft">
        <size value="600px 1px"/>
        <imageSliceId value="gui.colorPreset"/>
        <imageColor value="$preset_tc_divider"/>
    </Profile>
    <!-- Big name at the top of a details panel (job, worker, company). -->
    <Profile name="tc_panelHeading" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="600px 32px"/>
        <textSize value="22px"/>
        <textBold value="true"/>
        <textColor value="$preset_tc_valueText"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="middle"/>
        <textLayoutMode value="truncate"/>
    </Profile>
    <!-- Paragraph text inside a panel (warnings, notes, multi-line lists). -->
    <Profile name="tc_panelText" extends="fs25_textDefault" with="anchorTopLeft">
        <textSize value="15px"/>
        <textColor value="$preset_tc_valueText"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="top"/>
    </Profile>
    <Profile name="tc_panelNote" extends="tc_panelText">
        <textColor value="$preset_tc_mutedText"/>
    </Profile>
    <!-- Centered, muted message for an empty list or a locked tab. -->
    <Profile name="tc_emptyStateText" extends="fs25_textDefault" with="anchorTopLeft">
        <textSize value="20px"/>
        <textBold value="true"/>
        <textColor value="$preset_colorDisabled"/>
        <textAlignment value="center"/>
    </Profile>

    <!-- Label/value rows. Rows are stacked by a vertical BoxLayout, so a
         hidden row closes up (call invalidateLayout after toggling one). -->
    <Profile name="tc_detailRows" extends="emptyPanel" with="anchorTopLeft">
        <flowDirection value="vertical"/>
        <alignmentY value="top"/>
        <fillDirectionY value="topToBottom"/>
    </Profile>
    <Profile name="tc_detailRow" extends="emptyPanel">
        <size value="500px 34px"/>
    </Profile>
    <Profile name="tc_detailRowTall" extends="tc_detailRow">
        <size value="500px 54px"/>
    </Profile>
    <Profile name="tc_detailRowDivider" extends="baseReference" with="anchorBottomStretchingX">
        <height value="1px"/>
        <imageSliceId value="gui.colorPreset"/>
        <imageColor value="$preset_tc_divider"/>
    </Profile>
    <Profile name="tc_detailLabel" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="200px 34px"/>
        <textSize value="13px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_tc_mutedText"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="tc_detailValue" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="300px 34px"/>
        <textSize value="16px"/>
        <textColor value="$preset_tc_valueText"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="middle"/>
        <textLayoutMode value="truncate"/>
    </Profile>
    <!-- A value that can run to more lines than its row's label: top-aligned,
         so its first line sits level with the label (place it at y -9px). -->
    <Profile name="tc_detailValueTall" extends="tc_detailValue">
        <size value="300px 54px"/>
        <textSize value="15px"/>
        <textVerticalAlignment value="top"/>
        <textMaxNumLines value="2"/>
        <textLayoutMode value="truncate"/>
    </Profile>

    <!-- Status chip: a filled pill with a white label. The fill is set at
         runtime (MenuContractor's setChip); the label keeps white in every
         row state so it reads on a selected row too. -->
    <Profile name="tc_chip" extends="baseReference" with="anchorTopLeft">
        <size value="120px 20px"/>
        <color value="0.16 0.16 0.17 1"/>
        <cornerSize value="0.3"/>
    </Profile>
    <Profile name="tc_chipText" extends="baseReference" with="anchorTopLeft">
        <size value="120px 20px"/>
        <textSize value="11px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textLayoutMode value="resize"/>
        <textColor value="1 1 1 1"/>
        <textSelectedColor value="1 1 1 1"/>
        <textFocusedColor value="1 1 1 1"/>
        <textHighlightedColor value="1 1 1 1"/>
        <textDisabledColor value="1 1 1 1"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <!-- Chips inside a list row: vertically centred in the 32px row. -->
    <Profile name="tc_rowChip" extends="tc_chip" with="anchorMiddleLeft">
        <size value="100px 20px"/>
    </Profile>
    <Profile name="tc_rowChipText" extends="tc_chipText" with="anchorMiddleLeft">
        <size value="100px 20px"/>
    </Profile>
    <!-- Allocation picker tick box (replaces the old "[X] " text prefix). -->
    <Profile name="tc_rowCheckBox" extends="tc_chip" with="anchorMiddleLeft">
        <size value="16px 16px"/>
        <position value="10px 0px"/>
    </Profile>

    <!-- Overview reputation bar: tier name left, score right, then vanilla's
         contracts progress bar (fs25_contractsProgressBarBg is
         anchorTopCenter, so it centres in this box). Own title/value
         profiles rather than fs25_contractsContentTitle, which stretches to
         its container and reads as centred (see tickets/007's Outcome). -->
    <Profile name="tc_progressBox" extends="emptyPanel" with="anchorTopLeft">
        <size value="752px 80px"/>
    </Profile>
    <!-- Overview company card logo, square (TCCompanyLogo picks the image). -->
    <Profile name="tc_companyLogo" extends="baseReference" with="anchorTopLeft">
        <size value="204px 204px"/>
        <imageColor value="1 1 1 1"/>
    </Profile>
    <!-- Mouse-over tooltip (TCTooltip, after ADS's vehicle summary
         tooltip): a bordered card sized and placed at runtime, its children
         anchored bottom-left and positioned upwards by TCTooltip:show.
         newLayer: the engine draws a 2D layer's text after its images, so
         without a layer of its own the page's text shows through the card. -->
    <Profile name="tc_tooltipBox" extends="baseReference">
        <anchors value="0 0 0 0"/>
        <pivot value="0 0"/>
        <size value="680px 100px"/>
        <color value="$preset_tc_headerDivider"/>
        <cornerSize value="0.4"/>
        <handleFocus value="false"/>
        <newLayer value="true"/>
    </Profile>
    <Profile name="tc_tooltipSurface" extends="tc_tooltipBox">
        <position value="2px 2px"/>
        <size value="676px 96px"/>
        <color value="0.01 0.01 0.01 1"/>
        <cornerSize value="0.3"/>
        <newLayer value="false"/>
    </Profile>
    <Profile name="tc_tooltipText" extends="baseReference">
        <anchors value="0 0 0 0"/>
        <pivot value="0 0"/>
        <size value="640px 22px"/>
        <textSize value="14px"/>
        <textColor value="$preset_tc_valueText"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="top"/>
        <textMaxNumLines value="40"/>
        <textLayoutMode value="truncate"/>
        <handleFocus value="false"/>
    </Profile>
    <Profile name="tc_tooltipTitle" extends="tc_tooltipText">
        <size value="640px 28px"/>
        <textSize value="16px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
        <textVerticalAlignment value="middle"/>
        <textMaxNumLines value="1"/>
    </Profile>
    <Profile name="tc_tooltipDivider" extends="baseReference">
        <anchors value="0 0 0 0"/>
        <pivot value="0 0"/>
        <size value="640px 1px"/>
        <imageSliceId value="gui.colorPreset"/>
        <imageColor value="$preset_tc_headerDivider"/>
        <handleFocus value="false"/>
    </Profile>
    <Profile name="tc_progressTitle"extends="fs25_textDefault" with="anchorTopLeft">
        <size value="500px 26px"/>
        <textSize value="16px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_tc_valueText"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="tc_progressValue" extends="fs25_textDefault" with="anchorTopRight">
        <size value="250px 26px"/>
        <textSize value="16px"/>
        <textBold value="true"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
        <textAlignment value="right"/>
        <textVerticalAlignment value="middle"/>
    </Profile>

    <!-- Inbox (013) job list — same shape as FS25_RedTape/src/gui/guiProfiles.xml's
         rt_table/rtTableListItem/rtListRowCell*/rtTableHeader, just renamed
         tc_ for this mod. -->
    <Profile name="tc_tableHeader" extends="baseReference">
        <imageColor value="0 0 0 0" />
        <textFocusedColor value="$preset_fs25_colorMainHighlight" />
        <textHighlightedColor value="$preset_fs25_colorMainHighlight" />
        <textSize value="16px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textColor value="$preset_colorWhite_50" />
        <textAlignment value="left" />
        <textDisabledColor value="$preset_colorDisabled" />
    </Profile>
    <!-- Card rows (043): the ListItem itself is transparent; every row
         template starts with a tc_tableRowSurface (the rounded card, tinted
         when highlighted/selected) and a tc_tableRowAccent (a green bar down
         the left edge, only visible on the selected row, so the highlighted
         row stands out on a gamepad). -->
    <Profile name="tc_tableListItem" extends="baseReference" with="anchorTopStretchingX">
        <height value="32px"/>
        <imageColor value="0 0 0 0" />
        <imageSelectedColor value="0 0 0 0" />
        <imageFocusedColor value="0 0 0 0" />
        <imageHighlightedColor value="0 0 0 0" />
    </Profile>
    <Profile name="tc_tableRowSurface" extends="baseReference" with="anchorStretchingYStretchingX">
        <color value="$preset_tc_rowSurface"/>
        <colorFocused value="$preset_tc_rowFocused"/>
        <colorHighlighted value="$preset_tc_rowFocused"/>
        <colorSelected value="$preset_tc_rowSelected"/>
        <cornerSize value="0.2"/>
    </Profile>
    <Profile name="tc_tableRowAccent" extends="baseReference" with="anchorStretchingYLeft">
        <width value="4px"/>
        <imageSliceId value="gui.colorPreset"/>
        <imageColor value="0 0 0 0"/>
        <imageFocusedColor value="0 0 0 0"/>
        <imageHighlightedColor value="0 0 0 0"/>
        <imageSelectedColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="tc_listRowCellLeft" extends="baseReference" with="anchorStretchingYLeft">
        <textBold value="false" />
        <textSize value="15px" />
        <textAlignment value="left" />
        <textVerticalAlignment value="middle" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textSelectedColor value="1 1 1 1" />
        <textDisabledColor value="$preset_colorDisabled" />
    </Profile>
    <Profile name="tc_listRowCellRight" extends="tc_listRowCellLeft">
        <textAlignment value="right" />
    </Profile>
    <!-- Logbook (060) detail list: label/value rows like tc_detailRows, plus
         green section titles, as list rows so a long record scrolls. -->
    <Profile name="tc_listRowLabel" extends="tc_listRowCellLeft">
        <textSize value="13px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textColor value="$preset_tc_mutedText" />
        <textLayoutMode value="truncate" />
    </Profile>
    <Profile name="tc_listRowValue" extends="tc_listRowCellLeft">
        <textColor value="$preset_tc_valueText" />
        <textLayoutMode value="truncate" />
    </Profile>
    <Profile name="tc_listRowSection" extends="tc_listRowCellLeft">
        <textSize value="16px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textColor value="$preset_fs25_colorMainHighlight" />
        <textSelectedColor value="$preset_fs25_colorMainHighlight" />
    </Profile>
    <Profile name="tc_table" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft">
        <listItemSpacing value="3px"/>
    </Profile>
    <!-- Hairline under a table's column headings. -->
    <Profile name="tc_tableHeaderDivider" extends="baseReference" with="anchorBottomStretchingX">
        <height value="1px"/>
        <imageSliceId value="gui.colorPreset"/>
        <imageColor value="$preset_tc_headerDivider"/>
    </Profile>

    <!-- Plain, non-stretching header row container. Deliberately NOT
         fs25_statisticsHeaderBox (anchorTopStretchingX) — that mixin stretches
         to the full page width and recalculates child position based on that
         stretched width, which badly misaligns children when the box is also
         given an explicit fixed size (as our 600px-wide tables need) instead
         of actually spanning the page. anchorTopLeft keeps child "position"
         values a literal pixel offset from this row's own top-left corner,
         matching the coordinate space our SmoothList/ListItem cells already
         use, so header labels land directly above their column's content. -->
    <Profile name="tc_tableHeaderRow" extends="emptyPanel" with="anchorTopLeft" />

    <!-- Supplies (064) stock bar: a dark track with a fill over it, sized
         at runtime (MenuContractor's setBar, which also sets the fill's
         colour). Vertically centred in a 32px list row. -->
    <Profile name="tc_rowBarTrack" extends="baseReference" with="anchorMiddleLeft">
        <size value="150px 10px"/>
        <color value="0.12 0.12 0.13 1"/>
        <cornerSize value="0.3"/>
    </Profile>
    <Profile name="tc_rowBarFill" extends="tc_rowBarTrack">
        <color value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="tc_slider_box" extends="fs25_listSliderBox" with="anchorTopLeft" />
    <!-- The same, for the anchorTopCenter dialog layouts (086). -->
    <Profile name="tc_dialogSlider_box" extends="fs25_listSliderBox" with="anchorTopCenter" />

    <!-- Calendar (015) month selector — the same vanilla "< value >" chevron
         widget FS25_RedTape uses for its Active/New scheme switcher
         (rt_scheme_display_switcher extends fs25_subCategorySelector), so it
         gets the game's own styling for free instead of a hand-rolled pair
         of arrow buttons. -->
    <Profile name="tc_calendarPeriodSwitcher" extends="fs25_subCategorySelector" with="anchorTopLeft" />

    <!-- Advertising purchase dialog (027). anchorTopCenter so positions
         resolve against the dialog content container's top-centre, like
         fs25_dialogText's labels (same approach as FS25_RealisticLivestock's
         rl_filterDialog_picker). -->
    <Profile name="tc_adDialogPicker" extends="fs25_multiTextOption" with="anchorTopCenter">
        <size value="340px 36px" />
    </Profile>
    <Profile name="tc_adDialogInfoText" extends="fs25_dialogText" with="anchorTopCenter">
        <size value="680px 28px" />
        <textAlignment value="center" />
    </Profile>

    <!-- Repair quote dialog (102): the panel kit inside a dialog. The canvas
         is centred in the content container; everything in it is
         anchorTopLeft (the panel kit's own profiles), so positions are
         offsets from the canvas's top-left. -->
    <Profile name="tc_repairQuoteCanvas" extends="emptyPanel" with="anchorTopCenter">
        <size value="700px 480px" />
    </Profile>
    <!-- tc_detailRow is unanchored (it's for BoxLayouts); these rows are
         placed by hand, so their offsets need a top-left anchor. -->
    <Profile name="tc_repairQuoteRow" extends="tc_detailRow" with="anchorTopLeft"/>
    <Profile name="tc_repairQuotePicker"extends="fs25_multiTextOption" with="anchorTopLeft">
        <size value="340px 36px" />
    </Profile>
    <!-- What going without the missing kit means, under its chips. -->
    <Profile name="tc_repairQuoteKitNote" extends="tc_panelNote">
        <size value="652px 20px" />
        <textSize value="13px" />
        <textMaxNumLines value="1" />
    </Profile>

    <!-- Staff driver picker dialog (037). anchorTopCenter for the same
         reason as the advertising dialog's profiles above. -->
    <Profile name="tc_driverPickerList" extends="emptyPanel" with="anchorTopCenter">
        <listItemSpacing value="3px"/>
    </Profile>
    <!-- Parking slot filter dialog (086): a muted two-line hint under the
         heading. -->
    <Profile name="tc_parkingSlotHint" extends="fs25_dialogText" with="anchorTopCenter">
        <size value="680px 48px" />
        <textSize value="15px" />
        <textAlignment value="center" />
        <textColor value="$preset_colorWhite_50" />
    </Profile>
    <Profile name="tc_driverPickerColumn" extends="fs25_dialogText" with="anchorTopCenter">
        <textSize value="16px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textAlignment value="left" />
        <textColor value="$preset_colorWhite_50" />
    </Profile>

    <!-- Staff tab worker portrait (042). No filename: TCWorkerPortrait loads
         the scene itself, by full mod path. cameraNode indexes
         workerPortrait.i3d (root TransformGroup's second child). -->
    <Profile name="tc_workerPortrait" extends="baseReference" with="anchorTopLeft">
        <size value="260px 320px"/>
        <cameraNode value="0|1"/>
        <superSamplingFactor value="2"/>
    </Profile>

    <!-- Edit worker dialog (066): the same portrait, anchored like the other
         dialogs' profiles. -->
    <Profile name="tc_editWorkerPortrait" extends="baseReference" with="anchorTopCenter">
        <size value="260px 320px"/>
        <cameraNode value="0|1"/>
        <superSamplingFactor value="2"/>
    </Profile>
    <Profile name="tc_editWorkerLabel" extends="fs25_dialogText" with="anchorTopCenter">
        <size value="340px 28px" />
        <textSize value="16px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textAlignment value="center" />
        <textColor value="$preset_colorWhite_50" />
    </Profile>
    <Profile name="tc_editWorkerName" extends="fs25_dialogText" with="anchorTopCenter">
        <size value="340px 34px" />
        <textSize value="22px" />
        <textBold value="true" />
        <textAlignment value="center" />
    </Profile>
    <Profile name="tc_editWorkerHint" extends="fs25_dialogText" with="anchorTopCenter">
        <size value="340px 28px" />
        <textSize value="15px" />
        <textAlignment value="center" />
        <textColor value="$preset_colorWhite_50" />
    </Profile>
</GUIProfiles>
