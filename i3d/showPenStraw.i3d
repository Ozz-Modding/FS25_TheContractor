      <Shape name="fade6" shapeId="7" nodeId="26" castsShadows="true" receiveShadows="true" materialIds="1"/>
      <Shape name="fade7" shapeId="8" nodeId="27" castsShadows="true" receiveShadows="true" materialIds="1"/>
      <Shape name="fade8" shapeId="9" nodeId="28" castsShadows="true" receiveShadows="true" materialIds="1"/>
      <Shape name="fade9" shapeId="10" nodeId="29" castsShadows="true" receiveShadows="true" materialIds="1"/>
