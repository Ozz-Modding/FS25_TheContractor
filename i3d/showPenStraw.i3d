<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="showPenStraw" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="i3dConverter" version="1.0"/>
  </Asset>

  <Files>
    <File fileId="1" filename="$data/placeables/rudolfHormann/shared/strawBed_diffuse.dds"/>
    <File fileId="2" filename="$data/placeables/rudolfHormann/shared/strawBed_normal.dds"/>
    <File fileId="3" filename="$data/placeables/rudolfHormann/shared/strawBed_specular.dds"/>
    <File fileId="4" filename="$data/shaders/vertexPaintShader.xml"/>
  </Files>


  <Materials>
    <Material name="showPenStraw_mat" materialId="1" customShaderId="4" customShaderVariation="alphaNoise">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <CustomParameter name="uvScale" value="2.5 2.5 2.5 2.5"/>
      <CustomParameter name="snowScale" value="0"/>
      <CustomParameter name="alphaShift" value="0.3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="showPenStraw.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="showPenStraw" clipDistance="150" nodeId="19">
      <Shape name="fade0" shapeId="1" nodeId="20" castsShadows="true" receiveShadows="true" materialIds="1"/>
      <Shape name="fade1" shapeId="2" nodeId="21" castsShadows="true" receiveShadows="true" materialIds="1"/>
      <Shape name="fade2" shapeId="3" nodeId="22" castsShadows="true" receiveShadows="true" materialIds="1"/>
