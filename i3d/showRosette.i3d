<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="showRosette" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="i3dConverter" version="1.0"/>
  </Asset>

  <Files>
    <File fileId="1" filename="../images/showRosettes.dds"/>
  </Files>


  <Materials>
    <Material name="showRosette_mat" materialId="1">
      <Texture fileId="1"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="showRosette.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="showRosette" clipDistance="60" nodeId="8">
      <TransformGroup name="colours" nodeId="9">
        <Shape name="first" shapeId="1" nodeId="10" castsShadows="false" receiveShadows="true" materialIds="1"/>
        <Shape name="second" shapeId="2" nodeId="11" castsShadows="false" receiveShadows="true" materialIds="1"/>
        <Shape name="third" shapeId="3" nodeId="12" castsShadows="false" receiveShadows="true" materialIds="1"/>
        <Shape name="commended" shapeId="4" nodeId="13" castsShadows="false" receiveShadows="true" materialIds="1"/>
        <Shape name="champion" shapeId="5" nodeId="14" castsShadows="false" receiveShadows="true" materialIds="1"/>
      </TransformGroup>
    </TransformGroup>
  </Scene>

</i3D>
