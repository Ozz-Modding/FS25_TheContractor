<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="showPlotPeg" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="i3dConverter" version="1.0"/>
  </Asset>

  <Files>
    <File fileId="4" filename="$data/shaders/placeableShader.xml"/>
    <File fileId="1" filename="$data/shared/detailLibrary/nonMetallic/wood/wood2Oak_diffuse.dds"/>
    <File fileId="2" filename="$data/shared/detailLibrary/nonMetallic/wood/wood2_normal.dds"/>
    <File fileId="3" filename="$data/shared/detailLibrary/nonMetallic/wood/wood2_specular.dds"/>
    <File fileId="7" filename="../images/showPlotPegs.dds"/>
  </Files>


  <Materials>
    <Material name="showPlotPeg_atlas_mat" materialId="2">
      <Texture fileId="7"/>
    </Material>
    <Material name="showPlotPeg_oak_mat" materialId="1" customShaderId="4">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="showPlotPeg.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="showPlotPeg" clipDistance="200" nodeId="6">
      <Shape name="stake" shapeId="1" nodeId="7" castsShadows="true" receiveShadows="true" materialIds="1"/>
      <Shape name="flag" shapeId="2" nodeId="8" castsShadows="true" receiveShadows="true" materialIds="2"/>
    </TransformGroup>
  </Scene>

</i3D>
