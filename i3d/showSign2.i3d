<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="showSign2" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="i3dConverter" version="1.0"/>
  </Asset>

  <Files>
    <File fileId="4" filename="$data/shaders/placeableShader.xml"/>
    <File fileId="1" filename="$data/shared/detailLibrary/metallic/zincGalvanized_diffuse.dds"/>
    <File fileId="2" filename="$data/shared/detailLibrary/metallic/zincGalvanized_normal.dds"/>
    <File fileId="3" filename="$data/shared/detailLibrary/metallic/zincGalvanized_specular.dds"/>
    <File fileId="7" filename="$data/shared/detailLibrary/nonMetallic/wood/wood2Oak_diffuse.dds"/>
    <File fileId="8" filename="$data/shared/detailLibrary/nonMetallic/wood/wood2_normal.dds"/>
    <File fileId="9" filename="$data/shared/detailLibrary/nonMetallic/wood/wood2_specular.dds"/>
    <File fileId="10" filename="../images/showSign2.dds"/>
  </Files>


  <Materials>
    <Material name="auctionSignFace_mat" materialId="2">
      <Texture fileId="10"/>
    </Material>
    <Material name="auctionSignPost_mat" materialId="3" customShaderId="4">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="auctionSignWood_mat" materialId="1" customShaderId="4">
      <Texture fileId="7"/>
      <Normalmap fileId="8"/>
      <Glossmap fileId="9"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="showSign2.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="auctionSign" clipDistance="400" nodeId="9">
      <TransformGroup name="visuals" nodeId="10">
        <Shape name="posts" shapeId="1" nodeId="11" castsShadows="true" receiveShadows="true" materialIds="3"/>
        <Shape name="board" shapeId="2" nodeId="12" castsShadows="true" receiveShadows="true" materialIds="1"/>
        <Shape name="face" shapeId="3" nodeId="13" castsShadows="false" receiveShadows="true" materialIds="2"/>
      </TransformGroup>
      <Shape name="col" shapeId="4" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" density="0.0001" nodeId="14" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="1"/>
    </TransformGroup>
  </Scene>

</i3D>
